# Copy to .env only if you add remote runtime routes.
# vsw loads .env at startup. The build runs without any of these keys.
# OpenCode Go subscription (Console personal or service-account key).
OPENCODE_API_KEY=
# OpenRouter runtime transport.
OPENROUTER_API_KEY=

# Budget overrides
VSW_MAX_USD=2.00
VSW_MAX_WALL_SECONDS=900
VSW_MAX_DELEGATE_CALLS=8
VSW_PER_CALL_TIMEOUT=120
VSW_MAX_TASK_BUDGET_USD=0.50
VSW_MAX_ESCALATION_USD=1.00
