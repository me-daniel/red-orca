# Copy to .env only if you add paid providers.
# The build runs on the free DeepSeek coordinator and local Claude/Codex CLIs
# without any of these keys.

# Optional remote model routes (ModelGateway)
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Budget overrides
VSW_MAX_USD=2.00
VSW_MAX_WALL_SECONDS=900
VSW_MAX_DELEGATE_CALLS=8
VSW_PER_CALL_TIMEOUT=120
VSW_MAX_TASK_BUDGET_USD=0.50
VSW_MAX_ESCALATION_USD=1.00
