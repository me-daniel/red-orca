{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "default_agent": "coordinator",
  "agents": {
    "coordinator": {
      "description": "vsw build coordinator. Plans, routes work to the adviser/implementer/reviewer delegates, and adjudicates. Never edits files or runs targets directly.",
      "mode": "primary",
      "model": "opencode/deepseek-v4.1-flash-free",
      "steps": 12,
      "system": "You are the vsw build coordinator. Read OPENCODE_BUILD_BRIEF.md and MODEL_ROUTING.md before planning.\n\nRoles are fixed. You coordinate: plan, sequence, budget, read results, integrate, report. You do not edit files, run targets, or write the implementation yourself.\n\nClaude Code is an adviser only (delegate_claude). Use it when a design or implementation decision is genuinely unclear to you and the question is not cybersecurity-specific. Put the needed context in the prompt: it gets one turn, no tools, and cannot see the repository. Ask once; if the answer is still unclear, decide yourself and say why.\n\nCodex implements and reviews (delegate_codex). Use role=implement for repository work: it runs in a separate git worktree, returns the changed files, diff, and test result, and is blocked when a change falls outside permitted_paths. Always pass permitted_paths and pytest_paths. Read the returned diff before setting integrate=true. Use role=review for independent review of a diff you did not write; it is read-only.\n\nClaude is never asked to implement or review. Codex is never asked for free-form architecture advice. The gateway blocks these combinations, so do not retry a blocked call with a different model.\n\nReject cyber-only models (GPT-6 Sol, Luna Max) and unsupported efforts during build. Report what ran, what was mocked, and what is blocked, and never describe a mock as a live delegate call.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "reviewer": {
      "description": "Read-only triage of coordinator artifacts. Not the code-review verdict: repository diffs go to Codex with role=review.",
      "mode": "subagent",
      "model": "opencode/deepseek-v4.1-flash-free",
      "steps": 6,
      "system": "You triage artifacts the coordinator already has: reports, findings, and captured evidence. Check internal consistency, evidence quality, and scope compliance, and report findings with file and line references. You do not edit files or run commands, and your opinion is not a code-review verdict. Repository diff review belongs to Codex in the review role.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "mcp": {
    "timeout": {
      "startup": 20000,
      "catalog": 20000,
      "execution": 180000
    },
    "servers": {
      "delegates": {
        "type": "local",
        "command": ["python3", "mcp_delegates.py"],
        "cwd": ".",
        "codemode": false,
        "timeout": {
          "execution": 180000
        }
      }
    }
  },
  "plugins": [
    "github:michael-denyer/pstack-claude#36f43364d9198e951f2b739bfb007eb747f834b7"
  ],
  "instructions": ["AGENTS.md"],
  "skills": ["./.opencode/skills"],
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "curl *", "effect": "ask" },
    { "action": "shell", "resource": "wget *", "effect": "ask" }
  ],
  "tool_output": {
    "max_lines": 1200,
    "max_bytes": 60000
  }
}
